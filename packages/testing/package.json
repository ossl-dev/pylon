{
  "name": "@ossl/pylon-testing",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "test": "vitest run src --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@ossl/pylon-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@ossl/pylon-express": "workspace:*",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "zod": "^4.4.3",
    "@ossl/pylon-fastify": "workspace:*",
    "@ossl/pylon-hono": "workspace:*",
    "hono": "^4.12.25",
    "@ossl/pylon-koa": "workspace:*",
    "@types/koa": "^3.0.3",
    "koa": "^3.2.1",
    "@ossl/pylon-next": "workspace:*",
    "next": "^16.2.9",
    "@types/node": "^25.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
