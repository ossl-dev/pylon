{
  "name": "pylon-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc -p benchmarks/tsconfig.json",
    "clean": "turbo run clean",
    "format": "biome format --write .",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:publish": "changeset publish",
    "bench": "bun run build && bun benchmarks/versioning.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@changesets/cli": "^2.31.0",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.14"
  }
}
